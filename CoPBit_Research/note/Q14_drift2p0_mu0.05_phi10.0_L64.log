[Param] n_sym          = 500000
[Param] Eb/N0_list(dB) = [18.0, 20.0, 22.0]
[Param] lanes_list     = [64]
[Param] drift_list(deg)= [2.0]
[Param] channel        = b (taps = [0.05, 0.5, 1.0, 0.5, 0.05])
[Param] ffe_len        = 7
[Param] train_frac     = 0.2
[Param] mu_phase       = 0.05  (base, adaptive 전)
[Param] phi_max_deg    = 10.0
[Param] seed           = 1

